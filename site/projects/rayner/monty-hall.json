ance. The car is behind each door a third of the time. When it is behind A, he opens B or C with equal chance, a sixth each. When it is behind C, B is the only goat you didn’t pick, so he opens it in that whole third. You saw B open, so the rounds where he opened C are greyed. Of the 3 sixths left, the car is behind C in 2: switching wins 66.7%.","start":30.4,"end":65.3,"hold":31.5,"state":{"odds":{"doors":3,"host":"informed","stay":2,"swap":4,"discarded":0,"total":6,"continuing":6,"stayChance":0.3333333333333333,"switchChance":0.6666666666666666,"continuationChance":1,"opened":1},"cells":[{"prize":"A","opened":"B","shows":"goat","sixths":1,"stay":"win","swap":"lose"},{"prize":"A","opened":"C","shows":"goat","sixths":1,"stay":"win","swap":"lose"},{"prize":"B","opened":"C","shows":"goat","sixths":2,"stay":"lose","swap":"win"},{"prize":"C","opened":"B","shows":"goat","sixths":2,"stay":"lose","swap":"win"}],"opened":"B","seen":{"opened":"B","sixths":3,"swapSixths":2,"stayChance":0.3333333333333333,"switchChance":0.6666666666666666},"phase":"odds"},"changed":{"example":{"before":{"choice":0,"prize":2,"opened":1,"offered":2,"final":2,"won":true,"strategy":"switch"}},"host":{"before":"informed"},"revealed":{"before":false},"phase":{"before":"predict","after":"odds"},"odds":{"after":{"doors":3,"host":"informed","stay":2,"swap":4,"discarded":0,"total":6,"continuing":6,"stayChance":0.3333333333333333,"switchChance":0.6666666666666666,"continuationChance":1,"opened":1}},"cells":{"after":[{"prize":"A","opened":"B","shows":"goat","sixths":1,"stay":"win","swap":"lose"},{"prize":"A","opened":"C","shows":"goat","sixths":1,"stay":"win","swap":"lose"},{"prize":"B","opened":"C","shows":"goat","sixths":2,"stay":"lose","swap":"win"},{"prize":"C","opened":"B","shows":"goat","sixths":2,"stay":"lose","swap":"win"}]},"opened":{"after":"B"},"seen":{"after":{"opened":"B","sixths":3,"swapSixths":2,"stayChance":0.3333333333333333,"switchChance":0.6666666666666666}}},"picture":"Host who knows: 