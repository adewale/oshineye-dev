 a3424b7────────┐│\n│         commit two │ tree a3424b7 │ │hello.txblob 13ab7f7││\n│                    │parent 161f392│ │       \"hello again\\n\"\n│                    └──────────────┘ └─────────────────────┘\n│            The redraw kept all 76 shapes of commit one’s row and grew 94 new ones.\nmatch: 76 matched, 0 morphed, 0 removed, 94 added"},{"step":"head","title":"Moving main to commit two changes one reference","line":"refs/heads/main now holds commit two’s id; no object is copied.","caption":"HEAD names refs/heads/main, and moving the branch rewrote the id main holds from commit one to commit two, as the note under main says. No object was copied: both rows below are as they were, and commit one stays reachable through commit two’s parent link.","start":52.933,"end":69.833,"hold":59.267,"state":{"hello":"ce013625030ba8dba906f756967f9e9ca394464a","t1":"aaa96ced2d9a1c8e72c56b253a0e2fe78393feb7","c1":"161f3920c6abe4771d81f05869e2b962752044f9","head":"dfef583758597f177366effbb64f7176e5917b74","walks":[{"step":"commit","from":"Main","to":"C1","edge":"edge:Main->C1#0"},{"step":"commit","from":"C1","to":"T1","edge":"edge:C1->T1#0"},{"step":"commit","from":"T1","to":"Hello","edge":"edge:T1->Hello#0"},{"step":"head","from":"HEAD","to":"Main","edge":"edge:HEAD->Main#0"},{"step":"head","from":"Main","to":"C2","edge":"edge:Main->C2#0"},{"step":"head","from":"C2","to":"T2","edge":"edge:C2->T2#0"},{"step":"head","from":"T2","to":"New","edge":"edge:T2->New#0"}]},"changed":{"head":{"before":"161f3920c6abe4771d81f05869e2b962752044f9","after":"dfef583758597f177366effbb64f7176e5917b74"},"walks":{"before":[{"step":"commit","from":"Main","to":"C1","edge":"edge:Main->C1#0"},{"step":"commit","from":"C1","to":"T1","edge":"edge:C1->T1#0"},{"step":"commit","from":"T1","to":"Hello","edge":"edge:T1->Hello#0"}],"after":[{"step":"commit","from":"Main","to":"C1","edge":"edge:Main->C1#0"},{"step":"commit","from":"C1","to":"T1","edge":"edge:C1->T1#0"},{"step":"commit","from":"T1","to":"Hel