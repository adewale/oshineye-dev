              ▌      └───────────────────┘        └──────────────┘\n│                  ▌\n│                  ▌\n│                  ▌\n│                  ▌\n│\n│\n│                  ┌─────────────────────────────────────────────────────────┐\n│                  │ header  tree 37\\0                                       │\n│                  │▌                                                        │\n│                  │▌100644 hello.txt\\0 ce013625030ba8dba906f756967f9e9ca394464a\n│                  │ sha1    aaa96ced2d9a1c8e72c56b253a0e2fe78393feb7        │\n│                  └─────────────────────────────────────────────────────────┘\n│\n│"},{"step":"commit","title":"A commit names a tree; a branch names a commit","line":"main → commit → tree → blob: each holds the next one’s id.","caption":"The commit’s first line is its tree’s id. The branch main is just a reference holding the commit’s id. Follow main to the commit, its tree and the file bytes.","start":27.4,"end":38.667,"hold":32.933,"state":{"hello":"ce013625030ba8dba906f756967f9e9ca394464a","t1":"aaa96ced2d9a1c8e72c56b253a0e2fe78393feb7","c1":"161f3920c6abe4771d81f05869e2b962752044f9","head":"161f3920c6abe4771d81f05869e2b962752044f9","walks":[{"step":"commit","from":"Main","to":"C1","edge":"edge:Main->C1#0"},{"step":"commit","from":"C1","to":"T1","edge":"edge:C1->T1#0"},{"step":"commit","from":"T1","to":"Hello","edge":"edge:T1->Hello#0"}]},"changed":{"t1":{"after":"aaa96ced2d9a1c8e72c56b253a0e2fe78393feb7"},"c1":{"after":"161f3920c6abe4771d81f05869e2b962752044f9"},"head":{"after":"161f3920c6abe4771d81f05869e2b962752044f9"},"walks":{"after":[{"step":"commit","from":"Main","to":"C1","edge":"edge:Main->C1#0"},{"step":"commit","from":"C1","to":"T1","edge":"edge:C1->T1#0"},{"step":"commit","from":"T1","to":"Hello","edge":"edge:T1->Hello#0"}]}},"picture":"Flowchart: 4 nodes, 3 links; The content bytes \"hello\\n\", one cell each with its hex value; The header bytes “blob 6” and a zero byte, in front of the conten