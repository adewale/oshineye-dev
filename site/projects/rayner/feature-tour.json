               │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │     {value:'chart',label:'Charts'}]                                                     │\n│  │                                                                                         │\n│  │ }];                                                                                     │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │ const choice = settingsOf(this).feature;                                                │\n│  │                                                                                         │\n│  └─────────────────────────────────────────────────────────────────────────────────────────┘"},{"step":"result","title":"This case reads its chosen option","line":"","caption":"The picker above the picture is a real setting. Choose another feature and the page loads another prebuilt case with its own steps.","start":11.267,"end":19.9,"hold":12.233,"state":{"feature":"settings","phase":"result"},"changed":{"phase":{"before":"recipe","after":"result"}},"picture":"1 labelled value.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│\n│\n│                            ┌─────────────────────────────────────┐\n│                            │                                     │\n│                            │Case                        settings │\n│                            │                                     │\n│                            └─────────────────────────────────────┘\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│"}]},{"values":{"feature":"diagram"},"name":"Authoring feature: Diagrams","duration":21.4,"steps":[{"step":"recipe","title":"Capture a diagram, then follow a real edge","line":"","caption":"This is the author-side code for diagram. The graph is captured at build time. walk checks that the edge exists and leaves a trail; it is not a line drawn by guesswork.","start":0,"end":12,"hold":0.7,"state":{"feature":"diagram","phase":"recipe"},"changed":{"feature":{"after":"diagram"},"phase":{"after":"recipe"}},"picture":"Code, 4 lines.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│\n│\n│\n│\n│  ┌─────────────────────────────────────────────────────────────────────────────────────────┐\n│  │                                                                                         │\n│  │ const d = await s.show({source:                                                         │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │   'graph LR\\nA[Start] --> B[Finish]'},                                                  │\n│  │                                                                                         │\n│  │   {box: 'main'});                                                                       │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │ await d.walk([['A', 'B']], {trail: true});                                              │\n│  │                                                                                         │\n│  └─────────────────────────────────────────────────────────────────────────────────────────┘\n│\n│\n│\n│\n│"},{"step":"result","title":"The marked path remains","line":"","caption":"The graph is captured at build time. walk checks that the edge exists and leaves a trail; it is not a line drawn by guesswork.","start":12,"end":21.4,"hold":15.2,"state":{"feature":"diagram","phase":"result","walks":[{"step":"result","from":"A","to":"B","edge":"edge:A->B#0"}]},"changed":{"phase":{"before":"recipe","after":"result"},"walks":{"after":[{"step":"result","from":"A","to":"B","edge":"edge:A->B#0"}]}},"picture":"Flowchart: 2 nodes, 1 link. Travelled: Start → Finish.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│                       ▌\n│                       ▌\n│                       ▌\n│                       ▌\n│                       ▌      ┌───────────┐       ┌─────────────┐\n│                       ▌      │   ──────  │───────│   ───────   │\n│                       ▌      │           │       │             │\n│                       ▌      └───────────┘       └─────────────┘\n│                       ▌\n│                       ▌\n│                       ▌\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│"}]},{"values":{"feature":"code"},"name":"Authoring feature: Code panels","duration":17.633,"steps":[{"step":"recipe","title":"Show the author’s code, then focus a line","line":"","caption":"This is the author-side code for code. The code panel is an authoring helper. A line focus remains on screen; code.span and code.token can address smaller parts.","start":0,"end":10.133,"hold":0.7,"state":{"feature":"code","phase":"recipe"},"changed":{"feature":{"after":"code"},"phase":{"after":"recipe"}},"picture":"Code, 4 lines.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│\n│\n│\n│\n│     ┌───────────────────────────────────────────────────────────────────────────────────┐\n│     │                                                                                   │\n│     │ const block = await s.code([                                                      │\n│     │                                                                                   │\n│     │                                                                                   │\n│     │   'let count = 0;', 'count += 1;'                                                 │\n│     │                                                                                   │\n│     │ ], {at: 'main'});                                                                 │\n│     │                                                                                   │\n│     │                                                                                   │\n│     │ await block.focus(1, {as: 'update'});                                             │\n│     │                                                                                   │\n│     └───────────────────────────────────────────────────────────────────────────────────┘\n│\n│\n│\n│\n│"},{"step":"result","title":"The changed line stays marked","line":"","caption":"The code panel is an authoring helper. A line focus remains on screen; code.span and code.token can address smaller parts.","start":10.133,"end":17.633,"hold":11.533,"state":{"feature":"code","phase":"result"},"changed":{"phase":{"before":"recipe","after":"result"}},"picture":"Code, 2 lines. Update: 2: count += 1.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│\n│                                  ┌─────────────────────────┐\n│                                  │                         │\n│                                  │ let count = 0;          │\n│                                  ▌                         │\n│                                  ▌ count += 1;             │\n│                                  ▌                         │\n│                                  └─────────────────────────┘\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│"}]},{"values":{"feature":"code-diff"},"name":"Authoring feature: Code edits","duration":23.633,"steps":[{"step":"recipe","title":"Morph edited code by its surviving lines","line":"","caption":"This is the author-side code for code-diff. The first line stays while the changed line moves in and receives an added mark. TransformDiff handles a full diff when the code is a native Code object.","start":0,"end":13.133,"hold":0.7,"state":{"feature":"code-diff","phase":"recipe"},"changed":{"feature":{"after":"code-diff"},"phase":{"after":"recipe"}},"picture":"Code, 5 lines.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│\n│\n│\n│     ┌───────────────────────────────────────────────────────────────────────────────────┐\n│     │                                                                                   │\n│     │ const block = await s.code([                                                      │\n│     │                                                                                   │\n│     │   'let count = 0;', 'count += 1;'                                                 │\n│     │                                                                                   │\n│     │                                                                                   │\n│     │ ], {at: 'top'});                                                                  │\n│     │                                                                                   │\n│     │                                                                                   │\n│     │ await block.morph(['let count = 0;',                                              │\n│     │                                                                                   │\n│     │   'count += 2;'], {markAdded: true});                                             │\n│     │                                                                                   │\n│     └───────────────────────────────────────────────────────────────────────────────────┘\n│\n│\n│\n│"},{"step":"result","title":"The edited line is marked","line":"","caption":"The first line stays while the changed line moves in and receives an added mark. TransformDiff handles a full diff when the code is a native Code object.","start":13.133,"end":23.633,"hold":15.033,"state":{"feature":"code-diff","phase":"result"},"changed":{"phase":{"before":"recipe","after":"result"}},"picture":"Code, 2 lines. Added: 2: count += 2.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│\n│                                ┌─────────────────────────────┐\n│                                │                             │\n│                                │ let count = 0;              │\n│                                ┌┐                            │\n│                                ││count += 2;                 │\n│                                ││                            │\n│                                └┘────────────────────────────┘\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│"}]},{"values":{"feature":"animation"},"name":"Authoring feature: Animations","duration":17.633,"steps":[{"step":"recipe","title":"Animate one object into another","line":"","caption":"This is the author-side code for animation. The transform preserves the visible object across the step. FadeIn, Create, Succession and matching transforms use the same play clock.","start":0,"end":10.133,"hold":0.7,"state":{"feature":"animation","phase":"recipe"},"changed":{"feature":{"after":"animation"},"phase":{"after":"recipe"}},"picture":"Code, 4 lines.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│\n│\n│\n│\n│  ┌─────────────────────────────────────────────────────────────────────────────────────────┐\n│  │                                                                                         │\n│  │ const shape = new Circle({radius: 0.8});                                                │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │ await s.enter(shape, {describe: 'A shape'});                                            │\n│  │                                                                                         │\n│  │ await this.play(new Transform(shape,                                                    │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │   new Square({side: 1.6})));                                                            │\n│  │                                                                                         │\n│  └─────────────────────────────────────────────────────────────────────────────────────────┘\n│\n│\n│\n│\n│"},{"step":"result","title":"The circle becomes a square","line":"","caption":"The transform preserves the visible object across the step. FadeIn, Create, Succession and matching transforms use the same play clock.","start":10.133,"end":17.633,"hold":12.733,"state":{"feature":"animation","phase":"result"},"changed":{"phase":{"before":"recipe","after":"result"}},"picture":"A circle changes into a square.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│\n│\n│                     ╭────────╮\n│                     │        │\n│                     │        │\n│                     │        │\n│                     │        │\n│                     ╰────────╯\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│"}]},{"values":{"feature":"matching"},"name":"Authoring feature: Matching text","duration":18.4,"steps":[{"step":"recipe","title":"Match text by shared characters","line":"","caption":"This is the author-side code for matching. Matching pairs common text before introducing new letters. It is not a proof that two different words mean the same thing.","start":0,"end":10.5,"hold":0.7,"state":{"feature":"matching","phase":"recipe"},"changed":{"feature":{"after":"matching"},"phase":{"after":"recipe"}},"picture":"Code, 6 lines.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│\n│\n│  ┌─────────────────────────────────────────────────────────────────────────────────────────┐\n│  │                                                                                         │\n│  │ const before = new Text('cache miss');                                                  │\n│  │                                                                                         │\n│  │ await s.enter(before);                                                                  │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │ const after = new Text('cache hit');                                                    │\n│  │                                                                                         │\n│  │ await this.play(new TransformMatchingText(                                              │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │   before, after));                                                                      │\n│  │                                                                                         │\n│  │ s.keep(after);                                                                          │\n│  │                                                                                         │\n│  └─────────────────────────────────────────────────────────────────────────────────────────┘\n│\n│\n│"},{"step":"result","title":"The shared text stays recognisable","line":"","caption":"Matching pairs common text before introducing new letters. It is not a proof that two different words mean the same thing.","start":10.5,"end":18.4,"hold":13.1,"state":{"feature":"matching","phase":"result"},"changed":{"phase":{"before":"recipe","after":"result"}},"picture":"1 label.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│\n│\n│\n│\n│                     cache hit\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\nmatch: 6 matched, 0 morphed, 3 removed, 2 added"}]},{"values":{"feature":"restore"},"name":"Authoring feature: Restore","duration":14.633,"steps":[{"step":"recipe","title":"Save a look, then animate back to it","line":"","caption":"This is the author-side code for restore. saveState records the shape. Restore animates its points back; the saved object remains the same object.","start":0,"end":8.633,"hold":0.7,"state":{"feature":"restore","phase":"recipe"},"changed":{"feature":{"after":"restore"},"phase":{"after":"recipe"}},"picture":"Code, 5 lines.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│\n│\n│\n│  ┌─────────────────────────────────────────────────────────────────────────────────────────┐\n│  │                                                                                         │\n│  │ const circle = new Circle({radius: 0.8});                                               │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │ await s.enter(circle, {describe: 'Circle'});                                            │\n│  │                                                                                         │\n│  │ circle.saveState();                                                                     │\n│  │                                                                                         │\n│  │ await this.play(circle.animate.shift([1,0]));                                           │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │ await this.play(new Restore(circle));                                                   │\n│  │                                                                                         │\n│  └─────────────────────────────────────────────────────────────────────────────────────────┘\n│\n│\n│\n│"},{"step":"result","title":"The circle returns to its saved place","line":"","caption":"saveState records the shape. Restore animates its points back; the saved object remains the same object.","start":8.633,"end":14.633,"hold":12.233,"state":{"feature":"restore","phase":"result"},"changed":{"phase":{"before":"recipe","after":"result"}},"picture":"A circle moves right and returns to its saved position.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│\n│\n│                     ╭────────╮\n│                     │        │\n│                     │        │\n│                     │        │\n│                     │        │\n│                     ╰────────╯\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│"}]},{"values":{"feature":"emphasis"},"name":"Authoring feature: Emphasis","duration":15.4,"steps":[{"step":"recipe","title":"Leave emphasis in the resting picture","line":"","caption":"This is the author-side code for emphasis. Circumscribe with keep leaves an outline. The description gives a text alternative to an otherwise wordless mark.","start":0,"end":9,"hold":0.7,"state":{"feature":"emphasis","phase":"recipe"},"changed":{"feature":{"after":"emphasis"},"phase":{"after":"recipe"}},"picture":"Code, 7 lines.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│   ┌───────────────────────────────────────────────────────────────────────────────────────┐\n│   │                                                                                       │\n│   │ const target = new Text('42');                                                        │\n│   │                                                                                       │\n│   │                                                                                       │\n│   │ await s.enter(target);                                                                │\n│   │                                                                                       │\n│   │ const circle = new Circumscribe(target,                                               │\n│   │                                                                                       │\n│   │                                                                                       │\n│   │   {keep: true, color: s.emphasis});                                                   │\n│   │                                                                                       │\n│   │                                                                                       │\n│   │ s.keep(circle.outline,                                                                │\n│   │                                                                                       │\n│   │   {describe: 'Circle'});                                                              │\n│   │                                                                                       │\n│   │                                                                                       │\n│   │ await this.play(circle);                                                              