{"schema":1,"id":"feature-tour","title":"How do I write that in Rayner?","lang":"en","sources":["https://github.com/adewale/rayner/blob/main/scenes/explainers/feature-tour/scene.ts","https://github.com/adewale/rayner/blob/main/docs/REFERENCE.md"],"settings":[{"id":"feature","label":"Authoring feature","default":"steps","options":[{"value":"steps","label":"Steps and text"},{"value":"settings","label":"Settings"},{"value":"diagram","label":"Diagrams"},{"value":"code","label":"Code panels"},{"value":"code-diff","label":"Code edits"},{"value":"animation","label":"Animations"},{"value":"matching","label":"Matching text"},{"value":"restore","label":"Restore"},{"value":"emphasis","label":"Emphasis"},{"value":"camera","label":"Camera"},{"value":"chart","label":"Charts"},{"value":"state","label":"State and views"},{"value":"annotations","label":"Annotations"},{"value":"direction","label":"RTL layout"},{"value":"drawing","label":"Drawing tools"}]}],"cases":[{"values":{"feature":"steps"},"name":"Authoring feature: Steps and text","duration":17.633,"steps":[{"step":"recipe","title":"Name a step, then draw its resting picture","line":"","caption":"This is the author-side code for steps. A named step and a drawing are enough. The caption sits below the picture; the step name becomes a link.","start":0,"end":10.133,"hold":0.7,"state":{"feature":"steps","phase":"recipe"},"changed":{"feature":{"after":"steps"},"phase":{"after":"recipe"}},"picture":"Code, 7 lines.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│     ┌───────────────────────────────────────────────────────────────────────────────────┐\n│     │                                                                                   │\n│     │ await this.step('hello', {                                                        │\n│     │                                                                                   │\n│     │                                                                                   │\n│     │   title: 'Hello',                                                                 │\n│     │                                                                                   │\n│     │   caption: 'The greeting is visible.'                                             │\n│     │                                                                                   │\n│     │                                                                                   │\n│     │ });                                                                               │\n│     │                                                                                   │\n│     │                                                                                   │\n│     │ const hello = new Text('Hello!',                                                  │\n│     │                                                                                   │\n│     │   {fontSize: 1});                                                                 │\n│     │                                                                                   │\n│     │                                                                                   │\n│     │ await s.enter(hello);                                                             │\n│     │                                                                                   │\n│     └───────────────────────────────────────────────────────────────────────────────────┘\n│"},{"step":"result","title":"The greeting appears","line":"","caption":"A named step and a drawing are enough. The caption sits below the picture; the step name becomes a link.","start":10.133,"end":17.633,"hold":11.733,"state":{"feature":"steps","phase":"result"},"changed":{"phase":{"before":"recipe","after":"result"}},"picture":"1 label.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│