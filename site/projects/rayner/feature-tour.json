      │\n│  │                                                                                         │\n│  │ await s.enter(subject, {describe: 'Circle'});                                           │\n│  │                                                                                         │\n│  │ await s.focus(subject, {margin: 2});                                                    │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │ // await s.focus('all') returns home                                                    │\n│  │                                                                                         │\n│  └─────────────────────────────────────────────────────────────────────────────────────────┘\n│\n│\n│\n│\n│"},{"step":"result","title":"The camera moves closer","line":"","caption":"Camera focus changes the view, not the circle’s coordinates. The previous step shows the code; the circle fills the closer view.","start":10.5,"end":18.4,"hold":13,"state":{"feature":"camera","phase":"result"},"changed":{"phase":{"before":"recipe","after":"result"}},"picture":"A circle remains in the same place as the camera moves closer.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│                                ╭─────────╮\n│                                │         │\n│                                │         │\n│                                │         │\n│                                │         │\n│                                ╰─────────╯\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│"}]},{"values":{"feature":"chart"},"name":"Authoring feature: Charts","duration":17.633,"steps":[{"step":"recipe","title":"Plot the model’s numbers","line":"","caption":"This is the author-side code for chart. These three points, not hand-positioned bars, make the line. Axes can also plot a function or draw bars and guides.","start":0,"end":10.133,"hold":0.7,"state":{"feature":"chart","phase":"recipe"},"changed":{"feature":{"after":"chart"},"phase":{"after":"recipe"}},"picture":"Code, 5 lines.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│\n│\n│\n│  ┌─────────────────────────────────────────────────────────────────────────────────────────┐\n│  │                                                                                         │\n│  │ const axes = new Axes({xRange: [0,2,1],                                                 │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │   yRange: [0,2,1], width: 5, height: 3});                                               │\n│  │                                                                                         │\n│  │ const line = axes.lineGraph(                                                            │\n│  │                                                                                         │\n│  │   [[0,0],[1,2],[2,1]]);                                                                 │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │ await s.enter(axes, line, {describe: 'Plot'});                                          │\n│  │                                                                                         │\n│  └─────────────────────────────────────────────────────────────────────────────────────────┘\n│\n│\n│\n│"},{"step":"result","title":"Three values make a graph","line":"","caption":"These three points, not hand-positioned bars, make the line. Axes can also plot a function or draw bars and guides.","start":10.133,"end":17.633,"hold":11.733,"state":{"feature":"chart","phase":"result"},"changed":{"phase":{"before":"recipe","after":"result"}},"picture":"A line through values zero, two and one at x zero, one and two.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│         2 ┌─────────────────────────────┐\n│           ││                            │\n│           ││                            │\n│           ││                            │\n│           ││                            │\n│          1│─                            │\n│           ││                            │\n│           ││                            │\n│           ││                            │\n│         0 └─────────────────────────────┘─\n│           0              1              2\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│\n│"}]},{"values":{"feature":"state"},"name":"Authoring feature: State and views","duration":19.9,"steps":[{"step":"recipe","title":"Derive the picture from scene.state","line":"","caption":"This is the author-side code for state. The visible number is a view of the recorded state. Changing state and syncing rebuilds the picture; no separate label value is edited.","start":0,"end":11.267,"hold":0.7,"state":{"feature":"state","phase":"recipe"},"changed":{"feature":{"after":"state"},"phase":{"after":"recipe"}},"picture":"Code, 7 lines.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│  ┌─────────────────────────────────────────────────────────────────────────────────────────┐\n│  │                                                                                         │\n│  │ this.state.count = 0;                                                                   │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │ const label = view(this, state =>                                                       │\n│  │                                                                                         │\n│  │   new Text(String(state.count),                                                         │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │     {fontSize: 1}));                                                                    │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │ await s.enter(label, {describe: 'Count'});                                              │\n│  │                                                                                         │\n│  │ this.state.count = 1;                                                                   │\n│  │                                                                                         │\n│  │                                                                                         │\n│  │ await this.play(label.sync());                                                          │\n│  │                                                                                         │\n│  └─────────────────────────────────────────────────────────────────────────────────────────┘\n│"},{"step":"result","title":"The state-driven value changes","line":"","caption":"The visible number is a view of the recorded state. Changing state and syncing rebuilds the picture; no separate label value is edited.","start":11.267,"end":19.9,"hold":13.867,"state":{"feature":"state","phase":"result","count":1},"changed":{"phase":{"before":"recipe","after":"result"},"count":{"after":1}},"picture":"Recorded count: 1.","drawing":"┌──