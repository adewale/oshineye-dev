       ▌                    └──┘  └─────────────┘\n│         ▌\n│         ▌\n│\n│\n│                ┌─────────────────────────────────────────────────────────────┐\n│                │                                                             │\n│                │ s1 = exec(s0, pipeline, \"shout.txt\").shell                  │\n│                │ exec(s1, [[\"cat\", \"shout.txt\"]]).stdout   // \"HELLO\\n\"      │\n│                ▌ exec(s0, [[\"cat\", \"shout.txt\"]]).stdout   // \"\"             │\n│                ▌                                                             │\n│                │ s0.fs                               // {}                   │\n│                └─────────────────────────────────────────────────────────────┘\n│\n│"}]}]}