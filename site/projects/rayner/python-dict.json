d it, the other keys went into later slots. A lookup retraces that route, and a never-used slot tells it to stop. An emptied slot would end the search early, so deletion leaves a marker that says keep looking.","start":19.9,"end":46.167,"hold":20.6,"state":{"dict":{"indices":[-1,1,-1,-1,-1,-1,2,-1],"entries":[{"key":null,"value":null},{"key":8,"value":"pear"},{"key":16,"value":"plum"}]},"result":{"key":8,"slots":[0],"found":false,"value":null,"stopped":"unused"},"key":8,"policy":"incorrect-clear","phase":"broken"},"changed":{"dict":{"before":{"indices":[0,1,-1,-1,-1,-1,2,-1],"entries":[{"key":0,"value":"apple"},{"key":8,"value":"pear"},{"key":16,"value":"plum"}]},"after":{"indices":[-1,1,-1,-1,-1,-1,2,-1],"entries":[{"key":null,"value":null},{"key":8,"value":"pear"},{"key":16,"value":"plum"}]}},"result":{"before":{"key":8,"slots":[0,1],"found":true,"value":"pear","stopped":"key"},"after":{"key":8,"slots":[0],"found":false,"value":null,"stopped":"unused"}},"policy":{"before":"prediction","after":"incorrect-clear"},"phase":{"before":"question","after":"broken"}},"picture":"0. –. 1. 1. 2. –. 3. –. 4. –. 5. –. 6. 2. 7. –. Entry. Key. Value. 0. –. –. 1. 8. pear. 2. 16. plum. d[8]. Visit: 0. KeyError. pear is still stored, in entry 1.","drawing":"┌───────────────────────────────────────────────────────────────────────────────────────────────\n│\n│\n│\n│\n│\n│\n│         0          1          2          3         4          5          6          7\n│     ┌────────┐┌─────────┐┌────────┐ ┌────────┐ ┌────────┐ ┌────────┐┌─────────┐┌────────┐\n│     │   –    ││    1    ││    –   │ │    –   │ │   –    │ │   –    ││    2    ││    –   │\n│     └────────┘└─────────┘└────────┘ └────────┘ └────────┘ └────────┘└─────────┘└────────┘\n│\n│\n│          Entry          Key            Value                            d[8]\n│\n│       ─────────────────────────────────────────\n│                0       –             –                              Visit: 0\n│\n│                1       8      